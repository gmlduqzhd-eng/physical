{
  "name": "temp-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node scripts/runtime-regressions.cjs",
    "test:ui": "node scripts/ui-regressions.cjs",
    "test:hub": "node scripts/hub-tabs-regressions.cjs",
    "test:music": "node scripts/music-volume-regressions.cjs",
    "test:games": "node scripts/game-regressions.cjs",
    "test:physical": "tsx --test scripts/physical-activity-plans.test.ts",
    "test:catalog": "node scripts/game-catalog-smoke.cjs",
    "test:audit": "node scripts/audit-repair-regressions.cjs",
    "test:mobile": "node scripts/mobile-device-audit.mjs",
    "test:mobile-new-games": "node scripts/new-games-mobile-regressions.cjs",
    "test:mobile-inputs": "node scripts/legacy-mobile-regressions.cjs",
    "test:classroom-refresh": "node scripts/classroom-refresh-regressions.cjs",
    "test:guided": "tsx --test scripts/guided-classroom-features.test.ts",
    "test:concurrency": "node scripts/concurrency-audit.mjs",
    "dev:api": "tsx scripts/dev-api.ts",
    "teacher:setup": "node scripts/setup-teacher.mjs",
    "test:teacher": "tsx --test scripts/teacher-ai.test.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "dev:studio": "vite --config teacher-studio/vite.config.ts",
    "dev:studio:api": "tsx scripts/dev-studio-api.ts",
    "build:studio": "tsc --noEmit -p tsconfig.studio.json && vite build --config teacher-studio/vite.config.ts",
    "test:studio": "tsx --test scripts/gemini-studio.test.ts",
    "test:studio:deployment": "tsx --test scripts/studio-deployment.test.ts",
    "prepare:studio:deploy": "node scripts/prepare-studio-deploy.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.100",
    "@ai-sdk/openai": "4.0.97",
    "@supabase/supabase-js": "^2.108.2",
    "ai": "7.0.145",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.18.0",
    "qrcode": "1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "dotenv": "18.0.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
