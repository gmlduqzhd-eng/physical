# Public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
# Server only. Never prefix these with VITE_.
OPENAI_API_KEY=
# Use an available structured-output text model approved for your OpenAI project.
OPENAI_MODEL=
# Set true only after reviewing provider data controls and school approval.
AI_PRIVACY_REVIEWED=false
# Run npm run teacher:setup locally to generate these. No default PIN.
TEACHER_ACCESS_HASH=
TEACHER_SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
# Separate adult teacher studio only, in ignored .env.gemini.local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PUBLIC_DATA_REVIEWED=false
# Trusted classroom authorization bridge, ignored .env.classroom.local.
# Must match the SHA256 bootstrap value seeded in physical_internal.classroom_bootstrap.
# Never send this to a browser or prefix it with VITE_.
CLASSROOM_TEACHER_BOOTSTRAP=
